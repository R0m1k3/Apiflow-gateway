# Copier ce fichier en .env (exclu du git) et remplir les valeurs.
# Le token frp n'est pas ici : il est dans frps.toml (voir frps.toml.example).

# --- Source : PostgreSQL Debian, joint via le tunnel frps:15432 ---
# Mêmes valeurs que foirfouille-api/.env.docker (idéalement un rôle en lecture seule)
SRC_HOST=frps
SRC_PORT=15432
SRC_DB=CHANGE_ME_DB_NAME
SRC_USER=CHANGE_ME_DB_USER
SRC_PASS=CHANGE_ME_DB_PASSWORD

# --- Destination : PostgreSQL Hostinger (container postgres_db sur nginx_default) ---
DST_HOST=postgres_db
DST_PORT=5432
DST_DB=CHANGE_ME_DST_DB
DST_USER=CHANGE_ME_DST_USER
# Mot de passe long et aléatoire (openssl rand -hex 24) — l'ancien a fuité dans l'historique git
DST_PASS=CHANGE_ME_DST_PASSWORD

# --- Planification (cron 5 champs, fuseau ci-dessous) ---
SYNC_CRON=30 7 * * *
SYNC_TZ=Europe/Paris

# --- Tables ---
# Tables source à ne pas répliquer (liste séparée par des virgules), ex : client,adrclient,cartes
EXCLUDE_TABLES=
# Surcharge des tables "fenêtre" (table:colonne_date,…). Vide = liste par défaut du code :
# mvtart:datmvt,mvtreg:datmvt,mvtart_motif:datmvt,histo_art_gamme:date,demarques:datmvt,meteo:date,fidelite_jour:date
WINDOW_TABLES=
# Nombre de jours toujours rechargés pour les tables "fenêtre"
WINDOW_RECENT_DAYS=10

# --- Attente de la sync Debian (sync_log._run = 'running') ---
DEBIAN_WAIT_POLL_MIN=2
DEBIAN_WAIT_MAX_MIN=180

# --- Dashboard (HTTP Basic auth). Sans ces deux variables, le dashboard répond 503 ---
DASHBOARD_USER=CHANGE_ME_USER
DASHBOARD_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# --- Alerte webhook (Slack, Discord, Mattermost…) : vide = pas d'alerte ---
ALERT_WEBHOOK_URL=
